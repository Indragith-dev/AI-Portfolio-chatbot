# Google AI Studio key (aistudio.google.com). Required for /api/chat.
GEMINI_API_KEY=
# Optional. Override if Google retires or renames the default model.
GEMINI_MODEL=gemini-2.5-flash

# Comma-separated list of origins allowed to call this API. No trailing slashes.
ALLOWED_ORIGINS=http://localhost:3000,https://portfolio-indran.vercel.app

# Resend (resend.com) for /api/contact.
RESEND_API_KEY=
CONTACT_TO_EMAIL=nsindragith@gmail.com
# Must be on a domain verified in Resend. The default only delivers to your own Resend account email.
CONTACT_FROM_EMAIL=AIRA Contact <onboarding@resend.dev>

# Optional. Upstash Redis REST credentials. Without them, rate limits are kept
# in memory per serverless instance and reset on cold starts.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
